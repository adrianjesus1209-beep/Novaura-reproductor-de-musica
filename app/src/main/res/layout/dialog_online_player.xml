<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0C0C0E">

    <!-- Ambient Blurred Background -->
    <ImageView
        android:id="@+id/playback_blur_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="1.0"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:id="@+id/playback_scrim_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/ui_player_scrim" />

    <!-- Top Auxio Toolbar Matching Offline Mode -->
    <org.oxycblt.auxio.ui.AuxioToolbar
        android:id="@+id/online_player_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:menu="@menu/toolbar_online_playback"
        app:navigationIcon="@drawable/ic_down_24"
        app:subtitleCentered="true"
        app:subtitleTextAppearance="?attr/textAppearanceBodySmall"
        app:title="@string/lbl_playback"
        app:titleCentered="true"
        app:titleTextAppearance="?attr/textAppearanceLabelLargeEmphasized"
        tools:subtitle="@string/lbl_all_songs" />

    <!-- Center Large Artwork with Rounded Corners and Frosted Badge -->
    <FrameLayout
        android:id="@+id/online_player_cover_container"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_marginTop="8dp"
        android:paddingStart="65dp"
        android:paddingEnd="65dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/online_player_toolbar">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/online_player_cover_card"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:strokeWidth="0dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/online_player_large_cover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#202020"
                    android:scaleType="centerCrop"
                    tools:src="@drawable/ic_song_48" />

                <!-- Buffering indicator over artwork -->
                <ProgressBar
                    android:id="@+id/online_player_large_loading"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:visibility="gone" />

                <!-- Favorite Heart Button (Top Right of Cover) matching item_cover.xml -->
                <ImageView
                    android:id="@+id/online_player_favorite"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="12dp"
                    android:padding="8dp"
                    android:background="@drawable/bg_cover_favorite"
                    android:contentDescription="@string/lbl_favorites"
                    android:src="@drawable/ic_favorite_border_24" />

                <!-- Frosted Badge (Exact match to item_cover.xml) -->
                <LinearLayout
                    android:id="@+id/online_player_cover_badge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_cover_badge"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp">

                    <TextView
                        android:id="@+id/online_player_full_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="marquee"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:fontFamily="sans-serif-medium"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:singleLine="true"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        tools:text="Song Title" />

                    <TextView
                        android:id="@+id/online_player_full_artist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="#CCFFFFFF"
                        android:textSize="12sp"
                        tools:text="Artist Name" />

                </LinearLayout>

            </FrameLayout>

        </com.google.android.material.card.MaterialCardView>

    </FrameLayout>

    <!-- Waveform Seeker (Exact StyledSeekBar from Local Player) -->
    <org.oxycblt.auxio.playback.ui.StyledSeekBar
        android:id="@+id/online_player_seek_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_medium"
        android:layout_marginEnd="@dimen/spacing_medium"
        android:layout_marginTop="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/online_player_cover_container" />

    <!-- Main Playback Controls Container Matching Offline Player -->
    <org.oxycblt.auxio.playback.ui.ForcedLTRFrameLayout
        android:id="@+id/online_player_controls_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_medium"
        android:layout_marginEnd="@dimen/spacing_medium"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:minHeight="72dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/online_player_seek_bar"
        app:layout_constraintWidth_max="400dp">

        <org.oxycblt.auxio.playback.ui.button.ScaledPlaybackButtonGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:spacing="@dimen/spacing_small">

            <!-- Shuffle -->
            <org.oxycblt.auxio.playback.ui.button.ScaledPlaybackButton
                android:id="@+id/online_player_shuffle_btn"
                style="@style/Widget.Auxio.Button.Playback.Toggle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/desc_shuffle"
                app:icon="@drawable/sel_shuffle_state_24"
                app:iconSize="24dp" />

            <!-- Previous -->
            <org.oxycblt.auxio.playback.ui.button.ScaledPlaybackButton
                android:id="@+id/online_player_skip_prev_btn"
                style="@style/Widget.Auxio.Button.Playback.Skip"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:contentDescription="@string/desc_skip_prev"
                app:icon="@drawable/ic_skip_prev_24"
                app:iconSize="32dp" />

            <!-- Play / Pause -->
            <org.oxycblt.auxio.playback.ui.button.ScaledPlaybackButton
                android:id="@+id/online_player_play_pause_btn"
                style="@style/Widget.Auxio.Button.Playback.PlayPause"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:checkable="true"
                android:contentDescription="@string/desc_play_pause"
                app:icon="@drawable/sel_playing_state_24"
                app:iconSize="36dp"
                tools:icon="@drawable/ic_play_24" />

            <!-- Next -->
            <org.oxycblt.auxio.playback.ui.button.ScaledPlaybackButton
                android:id="@+id/online_player_skip_next_btn"
                style="@style/Widget.Auxio.Button.Playback.Skip"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:contentDescription="@string/desc_skip_next"
                app:icon="@drawable/ic_skip_next_24"
                app:iconSize="32dp" />

            <!-- Repeat -->
            <org.oxycblt.auxio.playback.ui.button.ScaledPlaybackButton
                android:id="@+id/online_player_repeat_btn"
                style="@style/Widget.Auxio.Button.Playback.Toggle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/desc_change_repeat"
                app:icon="@drawable/ic_repeat_off_24"
                app:iconSize="24dp" />

        </org.oxycblt.auxio.playback.ui.button.ScaledPlaybackButtonGroup>

    </org.oxycblt.auxio.playback.ui.ForcedLTRFrameLayout>

    <!-- Bottom Queue Tracklist Matching Local Player -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/online_player_tracklist"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingTop="2dp"
        android:paddingBottom="@dimen/spacing_medium"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/online_player_controls_container"
        tools:listitem="@layout/item_playback_track" />

    <View
        android:id="@+id/online_player_bottom_fade"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:background="@drawable/ui_playback_bottom_fade"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
