<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface"
    android:paddingBottom="24dp">

    <!-- Top Drag Handle -->
    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:id="@+id/online_player_drag_handle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Header Toolbar -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/online_player_close_btn"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        app:icon="@drawable/ic_down_24"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/online_player_drag_handle" />

    <TextView
        android:id="@+id/online_player_header_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/lbl_playing_online"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/online_player_close_btn"
        app:layout_constraintEnd_toStartOf="@+id/online_player_info_btn"
        app:layout_constraintStart_toEndOf="@+id/online_player_close_btn"
        app:layout_constraintTop_toTopOf="@+id/online_player_close_btn" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/online_player_info_btn"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="8dp"
        app:icon="@drawable/ic_details_24"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/online_player_drag_handle" />

    <!-- Large Rounded Cover Art -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/online_player_cover_card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="12dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="6dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/online_player_close_btn"
        app:strokeWidth="0dp">

        <ImageView
            android:id="@+id/online_player_large_cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/colorSurfaceContainerHigh"
            android:scaleType="centerCrop"
            tools:src="@drawable/ic_song_48" />

        <ProgressBar
            android:id="@+id/online_player_large_loading"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Title and Artist -->
    <TextView
        android:id="@+id/online_player_full_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="20dp"
        android:ellipsize="marquee"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:gravity="center"
        android:marqueeRepeatLimit="marquee_forever"
        android:singleLine="true"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/online_player_cover_card"
        tools:text="Smells Like Teen Spirit" />

    <TextView
        android:id="@+id/online_player_full_artist"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/online_player_full_title"
        tools:text="Nirvana" />

    <!-- Seek Slider -->
    <com.google.android.material.slider.Slider
        android:id="@+id/online_player_slider"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:value="0"
        android:valueFrom="0"
        android:valueTo="100"
        app:haloRadius="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/online_player_full_artist"
        app:thumbRadius="6dp" />

    <TextView
        android:id="@+id/online_player_time_current"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/online_player_slider"
        tools:text="0:00" />

    <TextView
        android:id="@+id/online_player_time_total"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/online_player_slider"
        tools:text="4:38" />

    <!-- Playback Controls -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/online_player_prev_btn"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        app:icon="@drawable/ic_skip_prev_24"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="32dp"
        app:layout_constraintBottom_toBottomOf="@+id/online_player_play_pause_fab"
        app:layout_constraintEnd_toStartOf="@+id/online_player_play_pause_fab"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/online_player_play_pause_fab" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/online_player_play_pause_fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        android:contentDescription="@string/lbl_play_online"
        app:elevation="4dp"
        app:fabCustomSize="64dp"
        app:layout_constraintEnd_toStartOf="@+id/online_player_next_btn"
        app:layout_constraintStart_toEndOf="@+id/online_player_prev_btn"
        app:layout_constraintTop_toBottomOf="@+id/online_player_time_current"
        app:srcCompat="@drawable/ic_play_24" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/online_player_next_btn"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        app:icon="@drawable/ic_skip_next_24"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="32dp"
        app:layout_constraintBottom_toBottomOf="@+id/online_player_play_pause_fab"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/online_player_play_pause_fab"
        app:layout_constraintTop_toTopOf="@+id/online_player_play_pause_fab" />

    <!-- Actions Row: Download & Add to Online Playlist (NO FAVORITES) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/online_player_play_pause_fab">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/online_player_full_download_btn"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/lbl_download"
            app:icon="@drawable/ic_download_24" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/online_player_full_playlist_btn"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/tab_online_playlists"
            app:icon="@drawable/ic_playlist_add_24" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
