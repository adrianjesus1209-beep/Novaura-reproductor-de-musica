<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:transitionGroup="true">

    <org.oxycblt.auxio.ui.CoordinatorAppBarLayout
        android:id="@+id/download_appbar"
        style="@style/Widget.Auxio.AppBarLayout"
        android:fitsSystemWindows="true"
        app:liftOnScroll="true"
        app:liftOnScrollTargetViewId="@id/download_recycler">

        <org.oxycblt.auxio.ui.AuxioToolbar
            android:id="@+id/download_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:navigationIcon="@drawable/ic_back_24">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingEnd="@dimen/spacing_small">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/download_search_input"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="@string/lbl_search_online_hint"
                    android:imeOptions="actionSearch|flagNoExtractUi"
                    android:inputType="text"
                    android:singleLine="true"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:paddingStart="@dimen/spacing_tiny"
                    android:paddingEnd="@dimen/spacing_tiny" />

                <ImageView
                    android:id="@+id/download_search_clear"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/lbl_download_clear"
                    android:focusable="true"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_close_24"
                    android:visibility="gone"
                    app:tint="?attr/colorOnSurfaceVariant"
                    tools:visibility="visible" />

                <ImageView
                    android:id="@+id/download_search_btn"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/lbl_download_music"
                    android:focusable="true"
                    android:padding="7dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_search_24"
                    app:tint="?attr/colorPrimary" />

            </LinearLayout>

        </org.oxycblt.auxio.ui.AuxioToolbar>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/download_search_loading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone"
            tools:visibility="visible" />

    </org.oxycblt.auxio.ui.CoordinatorAppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Results List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/download_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="96dp"
            tools:listitem="@layout/item_download_song" />

        <!-- Searching in Progress State -->
        <LinearLayout
            android:id="@+id/download_searching_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/spacing_large"
            android:visibility="gone">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminate="true"
                app:indicatorColor="?attr/colorPrimary"
                app:trackColor="?attr/colorSurfaceVariant" />

            <TextView
                style="@style/Widget.Auxio.TextView.Item.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:text="@string/lbl_download_searching" />

        </LinearLayout>

        <!-- No Results Found State -->
        <LinearLayout
            android:id="@+id/download_no_results_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/spacing_large"
            android:visibility="gone">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:alpha="0.5"
                android:contentDescription="@null"
                android:src="@drawable/ic_search_24"
                app:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                style="@style/Widget.Auxio.TextView.Item.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:text="@string/lbl_no_download_results" />

            <TextView
                style="@style/Widget.Auxio.TextView.Item.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_tiny"
                android:gravity="center"
                android:maxWidth="280dp"
                android:text="@string/lbl_try_different_search" />

        </LinearLayout>

        <!-- Initial Empty State with Suggestions -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/download_empty_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/download_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="36dp"
                android:paddingEnd="24dp"
                android:paddingBottom="96dp">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:alpha="0.8"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_download_24"
                    app:tint="?attr/colorPrimary" />

                <TextView
                    style="@style/Widget.Auxio.TextView.Item.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:text="@string/lbl_download_empty_prompt"
                    android:textSize="18sp" />

                <TextView
                    style="@style/Widget.Auxio.TextView.Item.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/lbl_download_suggestions"
                    android:textSize="14sp" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/download_suggestions_group"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:chipSpacingHorizontal="8dp"
                    app:chipSpacingVertical="8dp">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_top_hits"
                        style="@style/Widget.Auxio.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Top Éxitos" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_rock"
                        style="@style/Widget.Auxio.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rock" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_pop"
                        style="@style/Widget.Auxio.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pop en Español" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_reggaeton"
                        style="@style/Widget.Auxio.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reggaeton" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_lofi"
                        style="@style/Widget.Auxio.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lo-Fi Beats" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_anime"
                        style="@style/Widget.Auxio.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Anime OST" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_electronic"
                        style="@style/Widget.Auxio.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Electrónica" />

                </com.google.android.material.chip.ChipGroup>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <!-- Online Stream Mini-Player Bar -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/online_player_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:strokeWidth="1dp"
            app:strokeColor="#30FFFFFF"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
            tools:visibility="visible">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="10dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/online_player_thumb"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Small"
                        tools:src="@tools:sample/avatars" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/online_player_title"
                            style="@style/Widget.Auxio.TextView.Item.Primary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textSize="14sp"
                            tools:text="1985" />

                        <TextView
                            android:id="@+id/online_player_subtitle"
                            style="@style/Widget.Auxio.TextView.Item.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textSize="12sp"
                            tools:text="Bo Burnham • 1:15 / 2:27" />

                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginEnd="2dp">

                        <ImageView
                            android:id="@+id/online_player_play_pause"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:contentDescription="@string/lbl_play_online"
                            android:focusable="true"
                            android:padding="6dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_pause_24"
                            app:tint="?attr/colorPrimary" />

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/online_player_loading"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:indeterminate="true"
                            android:visibility="gone"
                            app:indicatorSize="24dp"
                            app:trackThickness="2.5dp" />

                    </FrameLayout>

                    <ImageView
                        android:id="@+id/online_player_download"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="2dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="@string/lbl_download"
                        android:focusable="true"
                        android:padding="7dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_download_24"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <ImageView
                        android:id="@+id/online_player_close"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="@string/lbl_close"
                        android:focusable="true"
                        android:padding="8dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_close_24"
                        app:tint="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/online_player_progress"
                    android:layout_width="match_parent"
                    android:layout_height="2.5dp"
                    android:layout_gravity="bottom"
                    android:indeterminate="false"
                    android:progress="0"
                    app:indicatorColor="?attr/colorPrimary"
                    app:trackColor="#20FFFFFF"
                    app:trackThickness="2.5dp" />

            </FrameLayout>

        </com.google.android.material.card.MaterialCardView>

    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
