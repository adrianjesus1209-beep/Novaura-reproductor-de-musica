<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:transitionGroup="true">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/download_appbar"
        style="@style/Widget.Auxio.AppBarLayout"
        android:fitsSystemWindows="true">

        <org.oxycblt.auxio.ui.AuxioToolbar
            android:id="@+id/download_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:navigationIcon="@drawable/ic_back_24"
            app:title="@string/lbl_download_music" />

        <!-- Tabs: Búsqueda | Listas Online | Descargas -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/download_tab_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurface"
            app:tabGravity="fill"
            app:tabIndicatorAnimationMode="elastic"
            app:tabIndicatorColor="?attr/colorPrimary"
            app:tabIndicatorFullWidth="false"
            app:tabIndicatorHeight="3dp"
            app:tabMode="fixed"
            app:tabRippleColor="?attr/colorControlHighlight"
            app:tabSelectedTextColor="?attr/colorPrimary"
            app:tabTextAppearance="?attr/textAppearanceLabelLarge"
            app:tabTextColor="?attr/colorOnSurfaceVariant">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:icon="@drawable/ic_search_24"
                android:text="@string/tab_search" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:icon="@drawable/ic_playlist_24"
                android:text="@string/tab_online_playlists" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:icon="@drawable/ic_download_24"
                android:text="@string/tab_downloads_queue" />

        </com.google.android.material.tabs.TabLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/download_search_loading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone"
            tools:visibility="visible" />

    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- ================= TAB 1: BÚSQUEDA ONLINE ================= -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_tab_search"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <!-- Search input box -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/download_search_bar_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/lbl_search_hint"
                        android:src="@drawable/ic_search_24"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/download_search_input"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="@string/lbl_search_online_hint"
                        android:imeOptions="actionSearch|flagNoExtractUi"
                        android:inputType="text"
                        android:paddingHorizontal="10dp"
                        android:singleLine="true"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />

                    <ImageView
                        android:id="@+id/download_search_clear"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="@string/lbl_download_clear"
                        android:focusable="true"
                        android:padding="6dp"
                        android:src="@drawable/ic_close_24"
                        android:visibility="gone"
                        app:tint="?attr/colorOnSurfaceVariant"
                        tools:visibility="visible" />

                    <ImageView
                        android:id="@+id/download_search_btn"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="@string/lbl_download_music"
                        android:focusable="true"
                        android:padding="5dp"
                        android:src="@drawable/ic_search_24"
                        app:tint="?attr/colorPrimary" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Search Results Recycler -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/download_recycler"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                android:paddingBottom="96dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/download_search_bar_card"
                tools:listitem="@layout/item_download_song" />

            <!-- Empty Search State -->
            <ScrollView
                android:id="@+id/download_empty_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:fillViewport="true"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/download_search_bar_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="32dp">

                    <ImageView
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:alpha="0.4"
                        android:contentDescription="@string/lbl_download"
                        android:src="@drawable/ic_download_24"
                        app:tint="?attr/colorOnSurface" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:text="@string/lbl_download_empty_prompt"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

            </ScrollView>

            <!-- No Results State -->
            <LinearLayout
                android:id="@+id/download_no_results_state"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/download_search_bar_card">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:alpha="0.3"
                    android:contentDescription="@string/lbl_no_download_results"
                    android:src="@drawable/ic_search_24"
                    app:tint="?attr/colorOnSurface" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/lbl_no_download_results"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="@string/lbl_try_different_search"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />

            </LinearLayout>

            <!-- Searching Loading State -->
            <LinearLayout
                android:id="@+id/download_searching_state"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/download_search_bar_card">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"
                    app:indicatorColor="?attr/colorPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/lbl_download_searching"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ================= TAB 2: LISTAS ONLINE ================= -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_tab_playlists"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/playlists_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/tab_online_playlists"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_create_online_playlist"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lbl_create_online_playlist"
                    app:icon="@drawable/ic_add_24" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/playlists_recycler"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:clipToPadding="false"
                android:paddingBottom="96dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/playlists_header"
                tools:listitem="@layout/item_online_playlist" />

            <LinearLayout
                android:id="@+id/playlists_empty_state"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/playlists_header"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:alpha="0.4"
                    android:contentDescription="@string/tab_online_playlists"
                    android:src="@drawable/ic_playlist_24"
                    app:tint="?attr/colorOnSurface" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/lbl_no_online_playlists"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="@string/lbl_online_playlists_empty_desc"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ================= TAB 3: COLA DE DESCARGAS ================= -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_tab_queue"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/queue_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/queue_header_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/tab_downloads_queue"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_pause_all"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lbl_pause_all" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_clear_completed"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lbl_clear_completed" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/downloads_queue_recycler"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:clipToPadding="false"
                android:paddingBottom="96dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/queue_header"
                tools:listitem="@layout/item_download_queue" />

            <LinearLayout
                android:id="@+id/downloads_empty_state"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/queue_header"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:alpha="0.4"
                    android:contentDescription="@string/tab_downloads_queue"
                    android:src="@drawable/ic_download_24"
                    app:tint="?attr/colorOnSurface" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/lbl_no_active_downloads"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="@string/lbl_downloads_empty_desc"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ================= MINI-PLAYER DOCKED INFERIOR (MATCHING OFFLINE BAR) ================= -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/online_player_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
            app:cardElevation="6dp"
            app:strokeWidth="0dp"
            app:shapeAppearance="@style/ShapeAppearance.Auxio.PlaybackBar"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            tools:visibility="visible">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/online_player_touch_area"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/online_player_thumb"
                    style="@style/Widget.Auxio.Image.Small"
                    android:layout_margin="@dimen/spacing_small"
                    android:scaleType="centerCrop"
                    app:layout_constraintBottom_toTopOf="@+id/online_player_progress_container"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:src="@tools:sample/avatars" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/online_player_loading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorSize="24dp"
                    app:trackThickness="2.5dp"
                    app:layout_constraintTop_toTopOf="@+id/online_player_thumb"
                    app:layout_constraintBottom_toBottomOf="@+id/online_player_thumb"
                    app:layout_constraintStart_toStartOf="@+id/online_player_thumb"
                    app:layout_constraintEnd_toEndOf="@+id/online_player_thumb" />

                <TextView
                    android:id="@+id/online_player_title"
                    style="@style/Widget.Auxio.TextView.Primary.Compact"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_small"
                    android:layout_marginEnd="@dimen/spacing_tiny"
                    android:ellipsize="marquee"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:singleLine="true"
                    app:layout_constraintBottom_toTopOf="@+id/online_player_subtitle"
                    app:layout_constraintEnd_toStartOf="@+id/online_player_controls_wrapper"
                    app:layout_constraintStart_toEndOf="@+id/online_player_thumb"
                    app:layout_constraintTop_toTopOf="@+id/online_player_thumb"
                    app:layout_constraintVertical_chainStyle="packed"
                    tools:text="Song Name" />

                <TextView
                    android:id="@+id/online_player_subtitle"
                    style="@style/Widget.Auxio.TextView.Secondary.Compact"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_small"
                    android:layout_marginEnd="@dimen/spacing_tiny"
                    android:ellipsize="marquee"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:singleLine="true"
                    app:layout_constraintBottom_toBottomOf="@+id/online_player_thumb"
                    app:layout_constraintEnd_toStartOf="@+id/online_player_controls_wrapper"
                    app:layout_constraintStart_toEndOf="@+id/online_player_thumb"
                    app:layout_constraintTop_toBottomOf="@+id/online_player_title"
                    tools:text="Artist Name" />

                <org.oxycblt.auxio.playback.ui.ForcedLTRFrameLayout
                    android:id="@+id/online_player_controls_wrapper"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_tiny"
                    app:layout_constraintBottom_toTopOf="@+id/online_player_progress_container"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <com.google.android.material.button.MaterialButtonGroup
                        android:id="@+id/online_player_controls_container"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:spacing="0dp"
                        app:buttonSizeChange="@xml/safe_button_group_size_change">

                        <org.oxycblt.auxio.ui.RippleFixMaterialButton
                            android:id="@+id/online_player_prev"
                            style="@style/Widget.Material3Expressive.Button.IconButton.Outlined"
                            app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.IconButton.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/desc_skip_prev"
                            app:backgroundTint="?attr/colorSurfaceContainerLow"
                            app:icon="@drawable/ic_skip_prev_24"
                            app:iconTint="@color/sel_checkable_icon"
                            app:strokeColor="@color/sel_checkable_outline"
                            tools:ignore="TouchTargetSizeCheck" />

                        <org.oxycblt.auxio.ui.RippleFixMaterialButton
                            android:id="@+id/online_player_play_pause"
                            style="@style/Widget.Auxio.Button.Playback.PlayPause"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:contentDescription="@string/desc_play_pause"
                            app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.IconButton.Small"
                            app:icon="@drawable/sel_playing_state_24" />

                        <org.oxycblt.auxio.ui.RippleFixMaterialButton
                            android:id="@+id/online_player_next"
                            style="@style/Widget.Material3Expressive.Button.IconButton.Outlined"
                            app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.IconButton.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/desc_skip_next"
                            app:backgroundTint="?attr/colorSurfaceContainerLow"
                            app:icon="@drawable/ic_skip_next_24"
                            app:iconTint="@color/sel_checkable_icon"
                            app:strokeColor="@color/sel_checkable_outline"
                            tools:ignore="TouchTargetSizeCheck" />

                        <org.oxycblt.auxio.ui.RippleFixMaterialButton
                            android:id="@+id/online_player_close"
                            style="@style/Widget.Material3Expressive.Button.IconButton"
                            app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.IconButton.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/desc_exit"
                            app:backgroundTint="@android:color/transparent"
                            app:icon="@drawable/ic_close_24"
                            app:iconTint="?attr/colorOnSurfaceVariant"
                            tools:ignore="TouchTargetSizeCheck" />

                    </com.google.android.material.button.MaterialButtonGroup>

                </org.oxycblt.auxio.playback.ui.ForcedLTRFrameLayout>

                <org.oxycblt.auxio.playback.ui.ForcedLTRFrameLayout
                    android:id="@+id/online_player_progress_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/online_player_progress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="@dimen/spacing_small"
                        android:layout_marginEnd="@dimen/spacing_small"
                        tools:progress="70" />

                </org.oxycblt.auxio.playback.ui.ForcedLTRFrameLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
