<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Smart Item: Añadidas recientemente -->
    <LinearLayout
        android:id="@+id/item_recently_added"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_medium"
        android:paddingTop="10dp"
        android:paddingEnd="@dimen/spacing_small"
        android:paddingBottom="10dp">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_more_time_24"
            app:tint="?attr/colorOnSurface"
            tools:ignore="ContentDescription" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_medium"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txt_recently_added_title"
                style="@style/Widget.Auxio.TextView.Item.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lbl_recently_added"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/txt_recently_added_count"
                style="@style/Widget.Auxio.TextView.Item.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                tools:text="10 canciones" />
        </LinearLayout>

        <org.oxycblt.auxio.ui.RippleFixMaterialButton
            android:id="@+id/btn_recently_added_menu"
            style="@style/Widget.Auxio.Button.Icon.Small"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:icon="@drawable/ic_more_vert_24"
            app:iconTint="?attr/colorOnSurfaceVariant"
            tools:ignore="ContentDescription" />
    </LinearLayout>

    <!-- Smart Item: Más reproducidas -->
    <LinearLayout
        android:id="@+id/item_most_played"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_medium"
        android:paddingTop="10dp"
        android:paddingEnd="@dimen/spacing_small"
        android:paddingBottom="10dp">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_headphones_24"
            app:tint="?attr/colorOnSurface"
            tools:ignore="ContentDescription" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_medium"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txt_most_played_title"
                style="@style/Widget.Auxio.TextView.Item.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lbl_most_played"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/txt_most_played_count"
                style="@style/Widget.Auxio.TextView.Item.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                tools:text="113 canciones" />
        </LinearLayout>

        <org.oxycblt.auxio.ui.RippleFixMaterialButton
            android:id="@+id/btn_most_played_menu"
            style="@style/Widget.Auxio.Button.Icon.Small"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:icon="@drawable/ic_more_vert_24"
            app:iconTint="?attr/colorOnSurfaceVariant"
            tools:ignore="ContentDescription" />
    </LinearLayout>

    <!-- Smart Item: Favoritos -->
    <LinearLayout
        android:id="@+id/item_favorites"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_medium"
        android:paddingTop="10dp"
        android:paddingEnd="@dimen/spacing_small"
        android:paddingBottom="10dp">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_favorite_24"
            app:tint="?attr/colorOnSurface"
            tools:ignore="ContentDescription" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_medium"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txt_favorites_title"
                style="@style/Widget.Auxio.TextView.Item.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lbl_favorites"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/txt_favorites_count"
                style="@style/Widget.Auxio.TextView.Item.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                tools:text="87 canciones" />
        </LinearLayout>

        <org.oxycblt.auxio.ui.RippleFixMaterialButton
            android:id="@+id/btn_favorites_menu"
            style="@style/Widget.Auxio.Button.Icon.Small"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:icon="@drawable/ic_more_vert_24"
            app:iconTint="?attr/colorOnSurfaceVariant"
            tools:ignore="ContentDescription" />
    </LinearLayout>

    <!-- Section Header: Listas de reproducción & + Crear nuevo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_medium"
        android:paddingTop="@dimen/spacing_medium"
        android:paddingEnd="@dimen/spacing_small"
        android:paddingBottom="@dimen/spacing_small">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/Widget.Auxio.TextView.Item.Primary"
            android:text="@string/lbl_playlists"
            android:textSize="18sp"
            android:textStyle="bold" />

        <org.oxycblt.auxio.ui.RippleFixMaterialButton
            android:id="@+id/btn_playlist_sort"
            style="@style/Widget.Auxio.Button.Icon.Small"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            app:icon="@drawable/ic_sort_24"
            app:iconTint="?attr/colorOnSurface"
            tools:ignore="ContentDescription" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_create_playlist"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="36dp"
            android:paddingStart="6dp"
            android:paddingEnd="10dp"
            android:text="@string/lbl_create_new"
            android:textAllCaps="false"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_add_24"
            app:iconPadding="4dp"
            app:iconSize="18dp"
            app:iconTint="?attr/colorOnSurface" />
    </LinearLayout>

    <!-- Playlists List -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <org.oxycblt.auxio.list.recycler.FastScrollRecyclerView
            android:id="@+id/home_recycler"
            style="@style/Widget.Auxio.RecyclerView.Grid.WithAdaptiveFab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="2dp"
            android:paddingBottom="120dp"
            tools:listitem="@layout/item_parent" />

        <org.oxycblt.auxio.ui.EdgeFrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/home_no_music"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium"
                android:visibility="invisible">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/home_no_music_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_medium"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorSize="48dp"
                    app:trackThickness="4dp" />

                <org.oxycblt.auxio.home.list.CookieImageView
                    android:id="@+id/home_no_music_placeholder"
                    android:layout_width="@dimen/size_fast_scroll_popup"
                    android:layout_height="@dimen/size_fast_scroll_popup"
                    android:layout_marginBottom="@dimen/spacing_small"
                    android:backgroundTint="?attr/colorSurfaceVariant"
                    android:src="@drawable/ic_playlist_48"
                    app:tint="?attr/colorOnSurfaceVariant"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/home_no_music_msg"
                    android:layout_width="256dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_small"
                    android:textAlignment="center"
                    tools:text="@string/lng_empty_playlists" />

                <Button
                    android:id="@+id/home_no_music_action"
                    style="@style/Widget.Auxio.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="@string/lbl_new_playlist" />

            </LinearLayout>

        </org.oxycblt.auxio.ui.EdgeFrameLayout>
    </FrameLayout>
</LinearLayout>
