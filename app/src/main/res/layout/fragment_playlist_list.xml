<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Header button for "Añadidas recientemente" -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btn_recently_added"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_medium"
        android:layout_marginEnd="@dimen/spacing_medium"
        android:layout_marginTop="@dimen/spacing_small"
        android:layout_marginBottom="@dimen/spacing_small"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="?attr/colorOutlineVariant"
        app:cardBackgroundColor="?attr/colorSurfaceVariant">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_medium">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/ui_selection_badge_bg"
                android:backgroundTint="?attr/colorPrimary"
                android:padding="10dp"
                android:src="@drawable/ic_download_24"
                app:tint="?attr/colorOnPrimary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_medium"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txt_recently_added_title"
                    style="@style/Widget.Auxio.TextView.Item.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lbl_recently_added"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_recently_added_count"
                    style="@style/Widget.Auxio.TextView.Item.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="0 canciones" />
            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_open_20"
                app:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <org.oxycblt.auxio.list.recycler.FastScrollRecyclerView
            android:id="@+id/home_recycler"
            style="@style/Widget.Auxio.RecyclerView.Grid.WithAdaptiveFab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="120dp"
            tools:listitem="@layout/item_parent" />

        <org.oxycblt.auxio.ui.EdgeFrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/home_no_music"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium"
                android:visibility="invisible">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/home_no_music_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_medium"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorSize="48dp"
                    app:trackThickness="4dp" />

                <org.oxycblt.auxio.home.list.CookieImageView
                    android:id="@+id/home_no_music_placeholder"
                    android:layout_width="@dimen/size_fast_scroll_popup"
                    android:layout_height="@dimen/size_fast_scroll_popup"
                    android:layout_marginBottom="@dimen/spacing_small"
                    android:backgroundTint="?attr/colorSurfaceVariant"
                    android:src="@drawable/ic_playlist_48"
                    app:tint="?attr/colorOnSurfaceVariant"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/home_no_music_msg"
                    android:layout_width="256dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_small"
                    android:textAlignment="center"
                    tools:text="@string/lng_empty_playlists" />

                <Button
                    android:id="@+id/home_no_music_action"
                    style="@style/Widget.Auxio.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="@string/lbl_new_playlist" />

            </LinearLayout>

        </org.oxycblt.auxio.ui.EdgeFrameLayout>
    </FrameLayout>
</LinearLayout>
