<?xml version="1.0" encoding="utf-8"?>
<org.oxycblt.auxio.playback.ui.PlaybackMaskableFrameLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.ExtraLarge">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <org.oxycblt.auxio.image.CoverView
            android:id="@+id/cover"
            style="@style/Widget.Auxio.Image.Full"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:enablePlaybackIndicator="false"
            app:enableSelectionBadge="false"
            app:layout_constraintDimensionRatio="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <org.oxycblt.auxio.playback.ui.stepper.StepperOverlay
            android:id="@+id/cover_fast_seek_overlay"
            style="@style/Widget.Auxio.Image.Full"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/cover_favorite"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_margin="14dp"
            android:padding="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/lbl_favorites"
            android:src="@drawable/ic_favorite_border_24"
            app:tint="@android:color/white"
            app:layout_constraintEnd_toEndOf="@+id/cover"
            app:layout_constraintTop_toTopOf="@+id/cover" />

        <LinearLayout
            android:id="@+id/cover_badge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_cover_badge"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/cover"
            app:layout_constraintEnd_toEndOf="@+id/cover"
            app:layout_constraintStart_toStartOf="@+id/cover">

            <TextView
                android:id="@+id/cover_song_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                tools:text="Something In The Air - Bonob..." />

            <TextView
                android:id="@+id/cover_artist_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp"
                tools:text="Imagine Dragons" />

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</org.oxycblt.auxio.playback.ui.PlaybackMaskableFrameLayout>
