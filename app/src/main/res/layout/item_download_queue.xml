<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <ImageView
            android:id="@+id/queue_song_cover"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="?attr/colorSurfaceContainerHigh"
            android:contentDescription="@string/lbl_download"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toTopOf="@id/queue_song_progress"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@drawable/ic_song_24" />

        <TextView
            android:id="@+id/queue_song_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/queue_song_action_btn"
            app:layout_constraintStart_toEndOf="@+id/queue_song_cover"
            app:layout_constraintTop_toTopOf="@+id/queue_song_cover"
            tools:text="Smells Like Teen Spirit" />

        <TextView
            android:id="@+id/queue_song_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintEnd_toStartOf="@+id/queue_song_action_btn"
            app:layout_constraintStart_toEndOf="@+id/queue_song_cover"
            app:layout_constraintTop_toBottomOf="@+id/queue_song_title"
            tools:text="65% • Descargando…" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/queue_song_action_btn"
            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            app:icon="@drawable/ic_pause_24"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/queue_song_cover"
            app:layout_constraintEnd_toStartOf="@+id/queue_song_cancel_btn"
            app:layout_constraintTop_toTopOf="@+id/queue_song_cover" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/queue_song_cancel_btn"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:icon="@drawable/ic_close_24"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="?attr/colorError"
            app:layout_constraintBottom_toBottomOf="@+id/queue_song_cover"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/queue_song_cover" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/queue_song_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:indicatorColor="?attr/colorPrimary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/queue_song_cover"
            app:trackColor="?attr/colorSurfaceContainerHighest"
            app:trackCornerRadius="4dp"
            app:trackThickness="6dp"
            tools:progress="65" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
