<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:paddingStart="@dimen/spacing_medium"
    android:paddingTop="10dp"
    android:paddingEnd="@dimen/spacing_small"
    android:paddingBottom="10dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/playlist_cover"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="?attr/colorSurfaceContainerHigh"
        android:contentDescription="@string/tab_online_playlists"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium"
        tools:src="@drawable/ic_playlist_24" />

    <TextView
        android:id="@+id/playlist_name"
        style="@style/Widget.Auxio.TextView.Item.Primary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_medium"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@+id/playlist_song_count"
        app:layout_constraintEnd_toStartOf="@+id/playlist_play_btn"
        app:layout_constraintStart_toEndOf="@+id/playlist_cover"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="Favoritas de Rock" />

    <TextView
        android:id="@+id/playlist_song_count"
        style="@style/Widget.Auxio.TextView.Item.Secondary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_medium"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/playlist_play_btn"
        app:layout_constraintStart_toEndOf="@+id/playlist_cover"
        app:layout_constraintTop_toBottomOf="@+id/playlist_name"
        tools:text="14 canciones" />

    <org.oxycblt.auxio.ui.RippleFixMaterialButton
        android:id="@+id/playlist_play_btn"
        style="@style/Widget.Auxio.Button.Icon.Small"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:icon="@drawable/ic_play_24"
        app:iconTint="?attr/colorOnSurfaceVariant"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/playlist_menu_btn"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="ContentDescription" />

    <org.oxycblt.auxio.ui.RippleFixMaterialButton
        android:id="@+id/playlist_menu_btn"
        style="@style/Widget.Auxio.Button.Icon.Small"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:icon="@drawable/ic_more_vert_24"
        app:iconTint="?attr/colorOnSurfaceVariant"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="ContentDescription" />

</androidx.constraintlayout.widget.ConstraintLayout>
