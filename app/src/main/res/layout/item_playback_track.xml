<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="12dp">

        <org.oxycblt.auxio.image.CoverView
            android:id="@+id/track_cover"
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:enablePlaybackIndicator="false"
            app:enableSelectionBadge="false"
            app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Small" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/track_online_cover"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="#1F1F24"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Small" />

        <View
            android:id="@+id/track_playing_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#80000000"
            android:visibility="gone" />

        <TextView
            android:id="@+id/track_number"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="#80FFFFFF"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="1." />

        <ImageView
            android:id="@+id/track_equalizer_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_playing_indicator_24"
            android:visibility="gone"
            app:tint="@android:color/white" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/track_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            tools:text="Cool for the Summer" />

        <TextView
            android:id="@+id/track_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp"
            tools:text="traceyourself • 3:25" />

    </LinearLayout>

    <TextView
        android:id="@+id/track_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_small"
        android:textColor="#80FFFFFF"
        android:textSize="13sp"
        tools:text="4:49"
        tools:visibility="gone" />

    <ImageView
        android:id="@+id/track_drag_handle"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="6dp"
        android:padding="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/desc_song_handle"
        android:src="@drawable/ic_handle_24"
        app:tint="#80FFFFFF" />

</LinearLayout>
