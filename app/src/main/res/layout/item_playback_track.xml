<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/spacing_medium"
    android:paddingTop="10dp"
    android:paddingEnd="@dimen/spacing_medium"
    android:paddingBottom="10dp">

    <FrameLayout
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="@dimen/spacing_small">

        <TextView
            android:id="@+id/track_number"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="#80FFFFFF"
            android:textSize="13sp"
            tools:text="1." />

        <ImageView
            android:id="@+id/track_equalizer_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_playing_indicator_24"
            android:visibility="gone"
            app:tint="@color/player_accent_gold" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/track_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            tools:text="Something In The Air - Bonobo Remix" />

        <TextView
            android:id="@+id/track_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#80FFFFFF"
            android:textSize="12sp"
            tools:text="Night Vision" />

    </LinearLayout>

    <TextView
        android:id="@+id/track_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_small"
        android:textColor="#80FFFFFF"
        android:textSize="13sp"
        tools:text="4:49" />

</LinearLayout>
