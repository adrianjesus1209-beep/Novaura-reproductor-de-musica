<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <org.oxycblt.auxio.image.CoverView
        android:id="@+id/choice_cover"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:enablePlaybackIndicator="false"
        app:enableSelectionBadge="false"
        app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Medium" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/choice_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            tools:text="Clásica Relajante" />

        <TextView
            android:id="@+id/choice_track_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#9E9E9E"
            android:textSize="13sp"
            tools:text="0 pistas" />
    </LinearLayout>

    <ImageView
        android:id="@+id/choice_check"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_check_24"
        android:visibility="gone"
        app:tint="@android:color/white"
        tools:visibility="visible" />

</LinearLayout>
