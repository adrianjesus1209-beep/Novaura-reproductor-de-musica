<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottom_navigation_bar"
    android:layout_width="match_parent"
    android:layout_height="@dimen/bottom_nav_bar_height"
    android:background="@drawable/ui_bottom_nav_bg"
    android:elevation="8dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <!-- Tab 1: Home -->
    <FrameLayout
        android:id="@+id/nav_item_home"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true">

        <FrameLayout
            android:id="@+id/nav_indicator_home"
            android:layout_width="48dp"
            android:layout_height="32dp"
            android:layout_gravity="center">

            <ImageView
                android:id="@+id/nav_icon_home"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@string/lbl_home"
                android:src="@drawable/ic_home_24"
                app:tint="?attr/colorPrimary" />

        </FrameLayout>

    </FrameLayout>

    <!-- Tab 2: Songs -->
    <FrameLayout
        android:id="@+id/nav_item_songs"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true">

        <FrameLayout
            android:id="@+id/nav_indicator_songs"
            android:layout_width="48dp"
            android:layout_height="32dp"
            android:layout_gravity="center">

            <ImageView
                android:id="@+id/nav_icon_songs"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@string/lbl_songs"
                android:src="@drawable/ic_song_24"
                app:tint="#88FFFFFF" />

        </FrameLayout>

    </FrameLayout>

    <!-- Tab 3: Albums -->
    <FrameLayout
        android:id="@+id/nav_item_albums"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true">

        <FrameLayout
            android:id="@+id/nav_indicator_albums"
            android:layout_width="48dp"
            android:layout_height="32dp"
            android:layout_gravity="center">

            <ImageView
                android:id="@+id/nav_icon_albums"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@string/lbl_albums"
                android:src="@drawable/ic_album_24"
                app:tint="#88FFFFFF" />

        </FrameLayout>

    </FrameLayout>

    <!-- Tab 4: Artists -->
    <FrameLayout
        android:id="@+id/nav_item_artists"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true">

        <FrameLayout
            android:id="@+id/nav_indicator_artists"
            android:layout_width="48dp"
            android:layout_height="32dp"
            android:layout_gravity="center">

            <ImageView
                android:id="@+id/nav_icon_artists"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@string/lbl_artists"
                android:src="@drawable/ic_artist_24"
                app:tint="#88FFFFFF" />

        </FrameLayout>

    </FrameLayout>

    <!-- Tab 5: Playlists -->
    <FrameLayout
        android:id="@+id/nav_item_playlists"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true">

        <FrameLayout
            android:id="@+id/nav_indicator_playlists"
            android:layout_width="48dp"
            android:layout_height="32dp"
            android:layout_gravity="center">

            <ImageView
                android:id="@+id/nav_icon_playlists"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@string/lbl_playlists"
                android:src="@drawable/ic_playlist_24"
                app:tint="#88FFFFFF" />

        </FrameLayout>

    </FrameLayout>

</LinearLayout>
