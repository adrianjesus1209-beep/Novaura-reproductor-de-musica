<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottom_navigation_bar"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:layout_gravity="bottom|center_horizontal"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="72dp"
    android:background="@drawable/ui_bottom_nav_bg"
    android:elevation="6dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <!-- Tab 1: Home -->
    <LinearLayout
        android:id="@+id/nav_item_home"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/nav_icon_home"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/lbl_home"
            android:src="@drawable/ic_home_24"
            app:tint="?attr/colorPrimary" />

        <TextView
            android:id="@+id/nav_text_home"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:fontFamily="sans-serif-bold"
            android:text="@string/lbl_home"
            android:textColor="?attr/colorPrimary"
            android:textSize="12sp"
            android:visibility="visible" />

    </LinearLayout>

    <!-- Tab 2: Songs -->
    <LinearLayout
        android:id="@+id/nav_item_songs"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/nav_icon_songs"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/lbl_songs"
            android:src="@drawable/ic_song_24"
            app:tint="#88FFFFFF" />

        <TextView
            android:id="@+id/nav_text_songs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:fontFamily="sans-serif-bold"
            android:text="@string/lbl_songs"
            android:textColor="?attr/colorPrimary"
            android:textSize="12sp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Tab 3: Albums -->
    <LinearLayout
        android:id="@+id/nav_item_albums"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/nav_icon_albums"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/lbl_albums"
            android:src="@drawable/ic_album_24"
            app:tint="#88FFFFFF" />

        <TextView
            android:id="@+id/nav_text_albums"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:fontFamily="sans-serif-bold"
            android:text="@string/lbl_albums"
            android:textColor="?attr/colorPrimary"
            android:textSize="12sp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Tab 4: Artists -->
    <LinearLayout
        android:id="@+id/nav_item_artists"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/nav_icon_artists"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/lbl_artists"
            android:src="@drawable/ic_artist_24"
            app:tint="#88FFFFFF" />

        <TextView
            android:id="@+id/nav_text_artists"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:fontFamily="sans-serif-bold"
            android:text="@string/lbl_artists"
            android:textColor="?attr/colorPrimary"
            android:textSize="12sp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Tab 5: Playlists -->
    <LinearLayout
        android:id="@+id/nav_item_playlists"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/nav_icon_playlists"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/lbl_playlists"
            android:src="@drawable/ic_playlist_24"
            app:tint="#88FFFFFF" />

        <TextView
            android:id="@+id/nav_text_playlists"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:fontFamily="sans-serif-bold"
            android:text="@string/lbl_playlists"
            android:textColor="?attr/colorPrimary"
            android:textSize="12sp"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
