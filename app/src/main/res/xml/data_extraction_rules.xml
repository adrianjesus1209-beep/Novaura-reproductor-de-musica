<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Cache databases and large local theme artwork are useless/bloated between devices -->
    <cloud-backup>
        <exclude
            domain="database"
            path="music_cache.db" />
        <exclude
            domain="database"
            path="playback_persistence.db" />
        <exclude
            domain="file"
            path="theme" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="database"
            path="music_cache.db" />
        <exclude
            domain="database"
            path="playback_persistence.db" />
        <exclude
            domain="file"
            path="theme" />
    </device-transfer>
</data-extraction-rules>